# Copy to .env. Every variable the code reads appears here, including the ones
# with safe defaults — this file doubles as the configuration reference.

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                    # local | preview | production
DEBUG=true
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# Comma-separated. Never "*". 3100 is the Playwright suite's production build,
# kept off 3000 so it never adopts a running dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stackforge:stackforge@localhost:5432/stackforge
# Wiped and recreated by the test suite. Never point this at a real database.
TEST_DATABASE_URL=postgresql+asyncpg://stackforge:stackforge@localhost:5432/stackforge_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis ───────────────────────────────────────────────────────────────────
# Quota counting, caching, and the arq queue. Every caller fails open, so the
# API serves traffic with Redis down — each cache call just costs its one
# second connect timeout, which is noticeable on a tool run and not fatal.
REDIS_URL=redis://localhost:6379/0

# ── Exports (M18) ───────────────────────────────────────────────────────────
# auto | chromium | reportlab. `auto` uses headless Chromium when Playwright is
# importable and falls back to ReportLab otherwise, logging which it chose.
# Chromium is the production path and produces the client-ready output; it is
# not installed by `uv sync` because it costs a ~400 MB image:
#     uv pip install playwright && uv run playwright install chromium
# Pin to `chromium` where the fallback should be an error, not a log line.
PDF_BACKEND=auto
# Rendered bytes are a cache over deterministic generators; the run and the
# stack are the durable things.
EXPORT_TTL_DAYS=7
# Above this predicted size a bundle is queued for the worker instead of built
# in the request. The threshold is size, not format.
EXPORT_ASYNC_THRESHOLD_BYTES=524288

# ── Auth ────────────────────────────────────────────────────────────────────
# Ed25519 signing key for access tokens, PEM, newlines as \n.
# Generate with:  uv run python -m app.cli generate-keypair
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
AUTH_KEY_ID=k1

ACCESS_TOKEN_TTL_SECONDS=900             # 15 minutes
REFRESH_TOKEN_TTL_DAYS=30                # sliding
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=90       # hard ceiling
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_DAYS=7

# Cookie names are prefixed so they never collide with another app on localhost.
REFRESH_COOKIE_NAME=__sf_rt
ANON_COOKIE_NAME=__sf_anon
# blank = host-only, correct for local
COOKIE_DOMAIN=
COOKIE_SECURE=false                      # MUST be true in production

# Argon2id. Tuned to ~250ms on the target instance class; re-benchmark when
# that class changes.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# Lockout
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900

# Check candidate passwords against Have I Been Pwned via k-anonymity.
# Only the first 5 hash characters leave the process. Fails open.
HIBP_ENABLED=true

# ── Email ───────────────────────────────────────────────────────────────────
# Local: Mailpit over SMTP. Production: set EMAIL_PROVIDER=resend + API key.
EMAIL_PROVIDER=smtp                      # smtp | resend | console
EMAIL_FROM="StackForge <noreply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
RESEND_API_KEY=

# ── OAuth (optional — auth works fully without these) ───────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI (optional — features degrade to rule-based when absent) ──────────────
ANTHROPIC_API_KEY=

# ── Billing (optional — checkout is hidden when absent) ─────────────────────
# Both of these or neither. A secret key without a webhook secret takes
# payments and never hears that they succeeded, so the app refuses to boot in
# that state rather than silently failing to upgrade anyone.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Created by `uv run python -m app.cli stripe-sync`, never by hand in the
# dashboard — environments have to be reproducible, and a price id is not a
# thing to remember copying. A plan with no price here cannot be checked out
# and is shown without a buy button.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
# How long a failed payment keeps its features. Stripe retries inside this
# window; the downgrade happens when it gives up.
DUNNING_GRACE_DAYS=7

# Forward webhooks to a local server with the Stripe CLI:
#     stripe listen --forward-to localhost:8000/api/v1/billing/webhook
# It prints the signing secret to paste above.

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false                           # false = human-readable, for local
